#!/usr/bin/env bash
# Builds resources/js/ops with Vite to catch syntax and import errors.
set -euo pipefail
cd "$(dirname "$0")/.."
VITE_BIN="${VITE_BIN:-$(command -v vite || true)}"
if [ -z "$VITE_BIN" ]; then
  echo "Set VITE_BIN to a vite.js (e.g. a host app's node_modules/vite/bin/vite.js)" >&2
  exit 1
fi
node "$VITE_BIN" build --config scripts/vite.check.config.mjs
